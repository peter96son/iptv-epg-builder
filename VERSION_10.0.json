{
  "version": "13.0-stage6.1",
  "metadata_version": "11.4",
  "cache_schema": 12,
  "metadata_budget_semantics": "separate unique-title and actual TMDb HTTP budgets",
  "default_workflow_metadata_http_budget": 2500,
  "durable_metadata_snapshot": "data/metadata.sqlite3.gz",
  "features": [
    "SQLite metadata knowledge base",
    "durable git snapshot of metadata DB",
    "separate backfill workflow from committed output/epg.xml.gz",
    "shared concurrency group across update/backfill",
    "fiction-wide backfill with movie groups first",
    "negative-cache TTL/backoff respected",
    "dry-run and backfill reporting",
    "automatic scheduled metadata backfill",
    "unique-key backfill",
    "partial-first backfill",
    "optional TMDb multi fallback",
    "improved EPG title variants",
    "single-click update-backfill-finalize pipeline",
    "same-run newly found metadata appears in final EPG",
    "backfill/finalize reuse current epg.xml.gz without redownloading sources"
  ],
  "release": "13.0-stage6.1",
  "default_backfill_http_budget": 5000,
  "update_pipeline": [
    "build current EPG from sources using existing SQLite metadata",
    "backfill current fiction queue with 5000 TMDb HTTP requests",
    "re-apply updated SQLite metadata to the same epg.xml.gz",
    "save durable metadata snapshot and final EPG"
  ],
  "metadata_schema_version": 7,
  "knowledge_layer": {
    "tables": [
      "titles",
      "metadata",
      "people",
      "credits",
      "aliases",
      "statistics"
    ],
    "legacy_compatibility": [
      "title_cache",
      "imdb_entities"
    ],
    "migration": "automatic-in-place",
    "data_snapshot_policy": "preserve existing data/metadata.sqlite3.gz"
  },
  "knowledge_resolution": {
    "primary": "aliases.title_id -> titles -> metadata",
    "secondary": "exact canonical titles -> metadata",
    "legacy_fallback": "title_cache + legacy aliases",
    "tmdb": "only after local miss or incomplete display refresh"
  },
  "smart_aliases": {
    "conflict_safe": true,
    "evidence_count": true,
    "rules": [
      "yo-e",
      "quotes",
      "provider-prefix",
      "quality-suffix",
      "year-suffix",
      "dash-spacing"
    ]
  },
  "local_imdb": {
    "datasets": [
      "title.basics.tsv.gz",
      "title.ratings.tsv.gz"
    ],
    "lookup": "local SQLite by IMDb ID",
    "per_title_http_requests": 0,
    "fields": [
      "title_type",
      "primary_title",
      "original_title",
      "year",
      "end_year",
      "runtime_minutes",
      "genres",
      "rating",
      "votes",
      "adult"
    ],
    "durable_mirror": "matched entities copied into metadata.sqlite3"
  },
  "rich_epg": {
    "visible_desc": [
      "year",
      "runtime",
      "countries",
      "genres",
      "original_title",
      "overview",
      "IMDb rating/votes"
    ],
    "xmltv_fields": [
      "date",
      "length",
      "country",
      "category",
      "rating",
      "url"
    ],
    "technical_ids_in_description": false,
    "provider_description_policy": "keep useful prose; replace short technical stubs with richer overview"
  },
  "programme_artwork": {
    "source": "TMDb poster_path/backdrop_path already returned by search/find",
    "extra_http_for_posters": 0,
    "poster_size": "w500",
    "backdrop_size": "w780",
    "xmltv": [
      "programme/icon compatibility poster",
      "image type=poster orient=P",
      "image type=backdrop orient=L"
    ],
    "provider_icon_policy": "never overwrite an existing programme icon"
  },
  "uhf_compact": {
    "title": "Title (year) · IMDb rating",
    "programme_fields_removed_from_xml": [
      "date",
      "category",
      "country",
      "length"
    ],
    "description": "plot only",
    "rich_metadata_location": "metadata.sqlite3",
    "channel_display_name": "unchanged"
  }
}
